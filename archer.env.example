# archer.env.example — copy to archer.env and fill in your values
# NEVER commit archer.env to git (it is gitignored)
# Set GitHub Secrets with the same names for HuggingFace deployment

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# HMAC-SHA256 key for JWT session tokens and CSRF cookies.
# Leave empty to derive automatically from /etc/archer/master.key (HSM).
# Must be set explicitly when running outside the Pi (HuggingFace, local dev).
ARCHER_SECRET=

# Numeric owner PIN — must be 4+ digits; Tier 1 access from the URL ?pin= param.
# Used on HuggingFace where ARP-based MAC auth doesn't work.
ARCHER_OWNER_PIN=

# ── AI / LLM ──────────────────────────────────────────────────────────────────

# Groq API key for fast Llama inference (voice command AI responses).
# Get one at https://console.groq.com — free tier available.
GROQ_API_KEY=

# Google Gemini API key (fallback AI provider if Groq is unavailable).
GEMINI_API_KEY=

# OpenRouter API key — OpenAI-compatible gateway, tried after Groq/Cerebras/
# Gemini as a 4th independent fallback (not a replacement for them).
# Get one at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# ── DISCORD BOT ───────────────────────────────────────────────────────────────
# See self-host/README.md "Discord bot setup" for the full walkthrough
# (create the app, invite the bot, register commands, set the Interactions
# Endpoint URL — must be the PUBLIC Caddy block, Discord's servers need to
# reach it).

# Bot token — only needed to run discord_register_commands.py, not at runtime.
DISCORD_BOT_TOKEN=

# Application public key (Discord Developer Portal -> General Information).
DISCORD_PUBLIC_KEY=

# Application ID (Discord Developer Portal -> General Information).
DISCORD_APPLICATION_ID=

# Your Discord user ID — only this user can run commands or click alert buttons.
DISCORD_OWNER_ID=

# Channel ID for alerts that carry buttons (crash, parking armed).
DISCORD_ALERTS_CHANNEL_ID=

# Comma-separated Discord user IDs at each tier — DMed directly based on
# alert severity (discord_dm_fanout()), separate from DISCORD_OWNER_ID above.
DISCORD_OWNER_USER_IDS=
DISCORD_PASSENGER_USER_IDS=
DISCORD_FAMILY_USER_IDS=
DISCORD_VALET_USER_IDS=

# ── SLACK BOT ─────────────────────────────────────────────────────────────────
# Replaces Discord as the live integration — see self-host/README.md
# "Slack bot setup" for the full walkthrough (create the app, install to
# workspace, configure slash commands + interactivity, set channel/user IDs).
# Discord's env vars above still work if you re-enable discord_config['enabled'].

# Signing Secret (Slack app -> Basic Information).
SLACK_SIGNING_SECRET=

# Bot User OAuth Token, starts with xoxb- (Slack app -> OAuth & Permissions,
# after installing to your workspace). Needs the chat:write scope.
SLACK_BOT_TOKEN=

# One channel ID per tier (right-click a channel -> View channel details ->
# copy the ID at the bottom). Tiers 1-3 only.
SLACK_CHANNEL_OWNER=
SLACK_CHANNEL_PASSENGER=
SLACK_CHANNEL_FAMILY=

# Comma-separated Slack user IDs at each tier (click a person's profile ->
# More -> Copy member ID).
SLACK_OWNER_USER_IDS=
SLACK_PASSENGER_USER_IDS=
SLACK_FAMILY_USER_IDS=

# Single dedicated channel for panic-mode alerts (POST /panic/activate).
# Bypasses the tier-based channel routing above entirely.
SLACK_CHANNEL_PANIC=

# ── SPOTIFY ───────────────────────────────────────────────────────────────────

# Create an app at https://developer.spotify.com
# Set the redirect URI to: http://localhost:7860/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── WEATHER ───────────────────────────────────────────────────────────────────

# WeatherAPI.com key — free tier at https://weatherapi.com supports 1M calls/month
WEATHERAPI_KEY=

# ── AUTHENTICATION ────────────────────────────────────────────────────────────

# Pre-set master invite code (Tier 1). If empty, a cryptographically random
# 6-digit code is generated on each server restart. Persist it here if you want
# a stable code across restarts.
ARCHER_MASTER_CODE=

# Token the Raspberry Pi uses to register its tunnel URL with /terminal/pi_register.
# Must match on both Pi and server. Leave empty to disable Pi tunnel registration.
ARCHER_PI_TOKEN=

# Shared secret between beamng_bridge.py and the /beamng_data endpoint.
# Both sides must be set to the same value. Leave empty to disable token check.
BEAMNG_TOKEN=

# Signed tier-ceiling token for the OBDLink Bluetooth connection. Mint one
# with: python3 -c "from archer_state import make_obd_token; print(make_obd_token(1))"
# (tier 1 = owner ceiling; 2/3/4 for passenger/family/valet ceilings).
# Missing or invalid means obd_autodetect() never opens a real connection —
# fail-closed, same as if no adapter were physically present.
OBD_ACCESS_TOKEN=

# Server-to-Pi config sanity handshake ground truth (POST
# /terminal/pi_config_check, checked by pi/config_sanity_check.py before
# every Pi boot's obd_gatekeeper.py handshake). Each value must match what
# the Pi independently expects — see pi/config_sanity_check.py's own env
# vars (PI_EXPECTED_SERVER_IP, PI_EXPECTED_OBDLINK_SERIAL) and
# GATEKEEPER_KEY_FINGERPRINT below for exactly what "match" means for each.
SERVER_TAILSCALE_IP=
GATEKEEPER_KEY_FINGERPRINT=
OBDLINK_SERIAL=

# ── HARDWARE (Raspberry Pi only) ──────────────────────────────────────────────

# OBD-II adapter serial port. Auto-detected if unset.
# Examples: /dev/ttyUSB0  /dev/ttyAMA0  COM3
OBD_PORT=

# Arduino serial port for gauge/lighting control. Auto-detected if unset.
ARDUINO_PORT=

# A ReSpeaker mic array is auto-detected by device name — nothing to set
# for that. This only picks which of its channels feeds the recognizer.
# Default 0 (first raw mic channel, works across ReSpeaker variants).
RESPEAKER_CHANNEL_INDEX=0

# ── FEATURE FLAGS ─────────────────────────────────────────────────────────────

# Set to 'true' to run OBD emulator (no real OBD hardware needed — dev/demo mode).
USE_EMULATOR=true

# Set to 'true' to enable BeamNG telemetry bridge (UDP → Flask relay).
USE_BEAMNG=false

# Address archer.py's own listener binds to. Default 0.0.0.0. Set to 127.0.0.1
# when Caddy (or another reverse proxy on the same machine) is the only
# intended way in — otherwise the app port is reachable directly and Caddy's
# path allowlist can be bypassed.
# ARCHER_BIND_HOST=127.0.0.1

# Set to 'true' to enable HTTPS on the Flask server.
# On first boot a self-signed cert is auto-generated at /etc/archer/archer.crt/.key.
# Override cert/key paths with ARCHER_TLS_CERT / ARCHER_TLS_KEY.
USE_TLS=false

# ── DEPLOYMENT ────────────────────────────────────────────────────────────────

# HuggingFace token for syncing to Spaces (used in GitHub Actions only).
HF_TOKEN=

# Firebase service account JSON (single-line) for Android push notifications.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── NOTIFICATION ──────────────────────────────────────────────────────────────
# Quick-reference: minimum to run locally
#   ARCHER_SECRET=<any-random-string>
#   GROQ_API_KEY=<your-groq-key>
#
# Required for full functionality on Pi:
#   ARCHER_OWNER_PIN, SPOTIFY_*, WEATHERAPI_KEY, ARCHER_PI_TOKEN
#
# Required for HuggingFace (set as GitHub Secrets):
#   HF_TOKEN, ARCHER_SECRET, ARCHER_OWNER_PIN, GROQ_API_KEY,
#   SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET, WEATHERAPI_KEY,
#   FIREBASE_SERVICE_ACCOUNT_JSON
