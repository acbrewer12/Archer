<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#F0000000"
    android:padding="32dp">

    <!-- ARCHER logo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="ARCHER"
        android:textColor="#CC0000"
        android:textSize="52sp"
        android:letterSpacing="0.25"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="2006 GMC SIERRA 2500HD"
        android:textColor="#555555"
        android:textSize="9sp"
        android:letterSpacing="0.3" />

    <!-- Pulse rings + mic button -->
    <FrameLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="40dp"
        android:layout_gravity="center_horizontal">

        <!-- Outer ring (dimmest) -->
        <View
            android:id="@+id/ring2"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:background="@drawable/pulse_ring_dim"
            android:visibility="invisible" />

        <!-- Inner ring -->
        <View
            android:id="@+id/ring1"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/pulse_ring"
            android:visibility="invisible" />

        <!-- Mic button -->
        <FrameLayout
            android:id="@+id/mic_btn"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:background="@drawable/mic_circle"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🎤"
                android:textSize="30sp" />
        </FrameLayout>
    </FrameLayout>

    <!-- Status -->
    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Listening..."
        android:textColor="#CC0000"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:fontFamily="monospace" />

    <!-- What Archer heard -->
    <TextView
        android:id="@+id/transcript_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:gravity="center"
        android:minLines="1"
        android:fontFamily="sans-serif-light" />

    <!-- Archer's response -->
    <TextView
        android:id="@+id/response_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#888888"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:minLines="2"
        android:fontFamily="monospace" />

    <!-- Spacer -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/dismiss_btn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="DISMISS"
            android:textColor="#444444"
            android:background="@drawable/btn_outline"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/open_btn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="OPEN ARCHER"
            android:textColor="#CC0000"
            android:background="@drawable/btn_outline_red"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:fontFamily="monospace" />
    </LinearLayout>

</LinearLayout>
