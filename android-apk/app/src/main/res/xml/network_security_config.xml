<?xml version="1.0" encoding="utf-8"?>
<!--
  Replaces the old blanket android:usesCleartextTraffic="true" in AndroidManifest.xml.

  The app's default ARCHER_URL is https://aydencatman-archer.hf.space (see
  gradle.properties / build-apk.yml) — that origin, and everything else, is left
  to the platform default, which is HTTPS-only (cleartext disabled) because this
  app targets API 34.

  Cleartext HTTP is allowed ONLY for the truck's own local Pi hotspot, which has
  no TLS in its default configuration (archer.py run_display_server() falls back
  to plain HTTP unless USE_TLS=true):
    - 192.168.4.1  — the Pi's fixed hotspot IP (matches TRUCK_IP in helpers.js)
    - archer.local — the Pi's mDNS/avahi hostname on the local network
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.4.1</domain>
        <domain includeSubdomains="false">archer.local</domain>
    </domain-config>
</network-security-config>
