# Archer OS — Kernel Configuration Fragment
# Merged on top of arch/x86/configs/x86_64_defconfig via merge_config.sh
#
# Philosophy:
#   Hardware drivers  → all modules (=m)  — universal, dracut/udev loads only what's needed
#   Debug/tracing     → all disabled      — biggest speed/size win, useless in production
#   Boot essentials   → built-in (=y)     — kernel must self-start before initramfs runs
#   Legacy hardware   → removed           — floppy, ISDN, ham radio, etc.

# ── Identity ──────────────────────────────────────────────────────────────────
CONFIG_LOCALVERSION="-archer"
CONFIG_DEFAULT_HOSTNAME="archer"

# ── Performance: strip ALL debug/tracing overhead ─────────────────────────────
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_DYNAMIC_FTRACE is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_LOCKDEP is not set
# CONFIG_PROVE_LOCKING is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_RWSEMS is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_DEBUG_SLAB is not set
# CONFIG_DEBUG_PAGEALLOC is not set
# CONFIG_DEBUG_OBJECTS is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_KASAN is not set
# CONFIG_UBSAN is not set
# CONFIG_KCSAN is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

# ── Timer: 1000Hz for responsive UI ───────────────────────────────────────────
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_IDLE=y

# ── Preemption: responsive, low-latency UI ────────────────────────────────────
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_PREEMPT=y

# ── Boot essentials: must be built-in (=y), needed before initramfs unpacks ───
CONFIG_BLK_DEV_INITRD=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# USB host controllers built-in — GRUB hands off to the kernel which must
# immediately read the USB drive the OS is running from
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# Framebuffer built-in — so the console appears before udev loads GPU modules
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# ── Storage controllers — ALL built-in (=y) ──────────────────────────────────
# Must be =y so the kernel can find its disk before any module is loaded.
# Covers: real hardware (AHCI, NVMe), VMware (FUSION/mptspi, PVSCSI), QEMU (virtio)
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_PATA_MPIIX=m
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_MMC=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PCI=m

# VMware virtual SCSI controllers (LSI Logic + PVSCSI — VMware's two defaults)
CONFIG_FUSION=y
CONFIG_FUSION_SPI=y
CONFIG_SCSI_VMWARE_PVSCSI=y

# Virtio — QEMU/KVM VMs
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_SCSI=y

# ── USB Serial (OBD2 / ELM327 adapters) — modules ────────────────────────────
# Every common USB-serial chip an ELM327 adapter might use
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_GENERIC=m

# ── Ethernet — modules (covers every common NIC) ──────────────────────────────
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGBVF=m
CONFIG_IXGBE=m
CONFIG_R8169=m
CONFIG_ATL1C=m
CONFIG_ATL1E=m
CONFIG_ALTERA_TSE=m
CONFIG_BNX2=m
CONFIG_TG3=m
CONFIG_FORCEDETH=m
CONFIG_VMXNET3=m

# ── WiFi — modules (covers Intel, Atheros, Realtek, Broadcom) ─────────────────
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_ATH9K=m
CONFIG_ATH9K_HTC=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH10K_USB=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8192EE=m
CONFIG_RTL8188EE=m
CONFIG_RTL8723BE=m
CONFIG_BRCMFMAC=m
CONFIG_MT76=m
CONFIG_MT7921E=m

# ── CAN bus — modules (truck ECU/TCU/BCM access via Pi) ──────────────────────
CONFIG_CAN=m
CONFIG_CAN_RAW=m
CONFIG_CAN_BCM=m
CONFIG_CAN_GW=m
CONFIG_CAN_VCAN=m
CONFIG_CAN_SLCAN=m

# ── Sound / ALSA — modules (voice output) ─────────────────────────────────────
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_HDA=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_PCSP=m

# ── GPU / display — modules (loaded after boot) ───────────────────────────────
CONFIG_DRM=m
CONFIG_DRM_SIMPLEDRM=m
CONFIG_DRM_I915=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_NOUVEAU=m

# ── Input ─────────────────────────────────────────────────────────────────────
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID=m
CONFIG_HID_GENERIC=m
CONFIG_USB_HID=m

# ── Remove legacy hardware ─────────────────────────────────────────────────────
# CONFIG_FLOPPY is not set
# CONFIG_BLK_DEV_FD is not set
# CONFIG_ISDN is not set
# CONFIG_HAMRADIO is not set
# CONFIG_AX25 is not set
# CONFIG_IPX is not set
# CONFIG_APPLETALK is not set
# CONFIG_X86_LEGACY_VM86 is not set
